{
  "name": "website",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/studioember/website",
  "author": "Nathan Grey",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "@11ty/eleventy": "4.0.0-alpha.6",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@parcel/watcher": "^2.5.6",
    "@tailwindcss/cli": "^4.1.12",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12"
  },
  "scripts": {
    "dev": "yarn run dev:eleventy & yarn run dev:css",
    "dev:css": "yarn tailwindcss -i ./frameworks/tailwind/tailwind.css -o ./assets/css/generated/tailwind.css --watch",
    "dev:eleventy": "yarn clean:dev && eleventy --serve",
    "build": "yarn build:css && yarn build:eleventy && yarn prettier --write \"output/site/**/*.html\" && yarn test:seo && yarn test:forms && yarn test:referrals",
    "test:forms": "node scripts/verify-forms.mjs",
    "build:css": "yarn tailwindcss -i ./frameworks/tailwind/tailwind.css -o ./assets/css/generated/tailwind.css --minify",
    "build:eleventy": "yarn clean:site && eleventy",
    "clean:dev": "node -e \"require('node:fs').rmSync('output/dev', { recursive: true, force: true })\"",
    "clean:site": "node -e \"require('node:fs').rmSync('output/site', { recursive: true, force: true })\"",
    "format:html": "prettier --write 'output/site/**/*.html'",
    "test:seo": "node scripts/verify-seo.mjs",
    "test:referrals": "node scripts/verify-referrals.mjs"
  }
}
