{% set siteLang = lang | default('en') %}
{% set siteText = i18n[siteLang] %}
{% set localeHome = '/' ~ siteLang ~ '/' %}
<!doctype html>
<html lang="{{ lang | default('en') }}" class="scroll-smooth">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% if privacy_page %}
    <meta name="referrer" content="no-referrer">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-src 'none'; form-action 'none'; object-src 'none'; base-uri 'self'">
    {% endif %}

    {# ── Page title ── #}
    {% if meta_title %}
      {% set _page_title = meta_title %}
    {% elif title %}
      {% set _page_title = title ~ " · " ~ site.name %}
    {% else %}
      {% set _page_title = site.name %}
    {% endif %}
    {% set _page_desc = description or site.description %}
    {% set _page_url  = site.url ~ page.url %}
    {% set _og_image  = (site.url ~ image) if image else (site.url ~ "/assets/img/og-image.jpg") %}

    <title>{{ _page_title }}</title>
    {% include 'components/service-schema.njk' %}

    {# ── Core SEO ── #}
    <meta name="description" content="{{ _page_desc }}">
    <meta name="robots" content="{{ 'noindex, follow' if (noindex or lp_noindex) else 'index, follow' }}">
    <link rel="canonical" href="{{ _page_url }}">

    {% include 'components/hreflang.njk' %}

    {# ── Open Graph ── #}
    <meta property="og:type"        content="{{ og_type or 'website' }}">
    <meta property="og:url"         content="{{ _page_url }}">
    <meta property="og:title"       content="{{ _page_title }}">
    <meta property="og:description" content="{{ _page_desc }}">
    <meta property="og:image"       content="{{ _og_image }}">
    <meta property="og:image:alt"   content="{{ image_alt or i18n[lang | default('en')].social_img_alt }}">
    <meta property="og:site_name"   content="{{ site.name }}">
    <meta property="og:locale"      content="{{ locale | default('en_US') }}">
    {% for _alt in _locale_alternates %}
    <meta property="og:locale:alternate" content="{{ 'en_US' if _alt.lang == 'en' else 'es_ES' }}">
    {% endfor %}

    {# ── Twitter Card (X) ── #}
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="{{ _page_title }}">
    <meta name="twitter:description" content="{{ _page_desc }}">
    <meta name="twitter:image"       content="{{ _og_image }}">
    <meta name="twitter:image:alt"   content="{{ image_alt or i18n[lang | default('en')].social_img_alt }}">

    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicon/favicon-32x32.png' | url }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/favicon/favicon-16x16.png' | url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/favicon/apple-touch-icon.png' | url }}">
    <link rel="manifest" href="{{ '/assets/favicon/site.webmanifest' | url }}">
    {% if not privacy_page %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!--Fonts (non-blocking) -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap"></noscript>

    {% endif %}

    {% if page_style == 'home' %}
    <link rel="preload" href="{{ '/assets/img/og-image.jpg' | url }}" as="image" fetchpriority="high">
    {% endif %}

    <!-- Color Scheme -->
    <script>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const applyTheme = () => {
          const theme = media.matches ? "dark" : "light";
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
        };

        applyTheme();
        media.addEventListener("change", applyTheme);
      })();
    </script>

    {% if not privacy_page %}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18020466610"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4B4KP12KBL');
      gtag('config', 'AW-18020466610');
    </script>

    {% endif %}

    <!-- Style Sheets -->
    <link rel="stylesheet" href="{{ '/assets/css/generated/tailwind.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/theme/theme.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/footer.css' | url }}">
    {% if page_style == 'home' %}
    <link rel="stylesheet" href="{{ '/assets/css/daylight.css' | url }}">
    {% else %}
    <link rel="stylesheet" href="{{ '/assets/css/interior.css' | url }}">
    {% endif %}
    {% if privacy_page %}
    <link rel="stylesheet" href="{{ '/assets/css/referrals.css' | url }}">
    {% endif %}
  </head>
  <body class="site-body{% if page_style %} site-{{ page_style }}{% endif %}{% if privacy_page %} site-private{% endif %}">
    <a class="skip-link" href="#content">{{ 'Ir al contenido' if siteLang == 'es' else 'Skip to content' }}</a>
    {% block navigation %}
    {% include 'components/navigation.njk' %}
    {% endblock %}

    <main id="content" tabindex="-1" class="site-main{% if full_width or page_style == 'home' or page_style == 'landing' %} site-main-wide{% endif %}">
      {% if page_style != 'home' and page_style != 'landing' %}
      <div class="site-frame{% if full_width %} site-frame-wide{% endif %}">
      {% endif %}
      {% if title and title_hidden != true %}
      <header class="page-header horizon-hero">
        <h1>{{ title }}</h1>
        {% if description and description_hidden != true %}
        <p>{{ description }}</p>
        {% endif %}
        {% if date_hidden != true %}
        <p>{{ page.date | dateSimple(siteLang) }}</p>
        {% endif %}
      </header>
      {% endif %}

      {% block content %}
      {% if no_prose %}
        {{ content | safe }}
      {% else %}
        <div class="prose reading-copy">
          {{ content | safe }}
        </div>
      {% endif %}
      {% endblock %}
      {% if page_style != 'home' and page_style != 'landing' %}
      </div>
      {% endif %}
    </main>

    {% block footer %}
    {% include 'components/footer.njk' %}
    {% endblock %}
  </body>
</html>
