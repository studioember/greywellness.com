---
layout: layouts/base.njk
no_prose: true
title_hidden: true
date_hidden: true
---
{% set _lang = lang | default("en") %}
{% set isSpanish = _lang == "es" %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "{{ 'Diario de Sueño de 7 Días' if isSpanish else '7-Day Sleep Diary' }}",
  "description": "{{ description }}",
  "url": "{{ site.url }}{{ page.url }}",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript and browser storage",
  "inLanguage": "{{ 'es' if isSpanish else 'en' }}",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Grey Wellness",
    "url": "{{ site.url }}"
  }
}
</script>

<div class="not-prose" data-sleep-diary data-lang="{{ _lang }}">
  <section class="relative overflow-hidden rounded-2xl border border-border px-6 py-14 sm:px-10 md:py-16" style="background: linear-gradient(135deg, hsl(var(--hero-overlay)), hsl(var(--primary) / 0.72))">
    <div class="absolute -right-16 -top-20 h-64 w-64 rounded-full bg-white/10" aria-hidden="true"></div>
    <div class="relative max-w-3xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-white/70">{{ "Sueño" if isSpanish else "Sleep" }}</p>
      <h1 class="mb-5 text-3xl font-bold leading-tight text-white md:text-5xl">{{ "Mi Diario de Sueño" if isSpanish else "My Sleep Diary" }}</h1>
      <p class="max-w-2xl text-lg leading-relaxed text-white/80">{{ "Siete mañanas. Una imagen más clara de tu sueño. Registra lo que recuerdes; no tiene que ser perfecto para ser útil." if isSpanish else "Seven mornings. A clearer picture of your sleep. Record what you remember—it does not have to be perfect to be useful." }}</p>
    </div>
  </section>

  <section class="py-10 md:py-14">
    <div class="mb-7 rounded-xl border border-border bg-card p-5 text-sm leading-relaxed text-muted">
      <p><span class="font-semibold text-foreground">{{ "Hazlo por la mañana:" if isSpanish else "Complete it in the morning:" }}</span> {{ "Calcula los tiempos en lugar de mirar el reloj durante la noche. Tus estimaciones no tienen que ser perfectas para ayudarte a notar patrones." if isSpanish else "Estimate the times instead of watching the clock during the night. Your estimates do not have to be perfect to help you notice patterns." }}</p>
    </div>

    <div class="mb-7 overflow-x-auto" aria-label="{{ 'Días completados' if isSpanish else 'Completed diary days' }}">
      <div class="flex min-w-max gap-2" data-diary-days></div>
    </div>

    <form class="rounded-2xl border border-border bg-card p-6 shadow-sm md:p-8" data-diary-form>
      <div class="mb-7 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-primary">{{ "Acerca de anoche" if isSpanish else "About Last Night" }}</p>
          <h2 class="mt-2 text-2xl font-bold text-foreground" data-entry-heading></h2>
        </div>
        <p class="text-sm text-muted" data-progress-label></p>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <label class="block rounded-xl border border-border bg-background p-5">
          <span class="mb-2 block font-semibold text-foreground">{{ "Hora en que te acostaste" if isSpanish else "Time you got into bed" }}</span>
          <span class="mb-3 block text-sm text-muted">{{ "Cuando te metiste en la cama, aunque todavía no estuvieras intentando dormir." if isSpanish else "When you got into bed, even if you were not trying to sleep yet." }}</span>
          <input name="bedTime" type="time" class="w-full rounded-md border border-border bg-card px-3 py-2 text-foreground" required>
        </label>

        <label class="block rounded-xl border border-border bg-background p-5">
          <span class="mb-2 block font-semibold text-foreground">{{ "Hora en que intentaste dormir" if isSpanish else "Attempted sleep time" }}</span>
          <span class="mb-3 block text-sm text-muted">{{ "Cuando apagaste todo y comenzaste a intentar dormir." if isSpanish else "When you turned things off and began trying to fall asleep." }}</span>
          <input name="attemptedSleep" type="time" class="w-full rounded-md border border-border bg-card px-3 py-2 text-foreground" required>
        </label>

        <label class="block rounded-xl border border-border bg-background p-5">
          <span class="mb-2 block font-semibold text-foreground">{{ "¿Cuánto tardaste en dormirte?" if isSpanish else "How long did it take to fall asleep?" }}</span>
          <span class="mb-3 block text-sm text-muted">{{ "Haz tu mejor cálculo en minutos." if isSpanish else "Give your best estimate in minutes." }}</span>
          <span class="flex items-center gap-3"><input name="sol" type="number" inputmode="numeric" min="0" max="720" class="w-28 rounded-md border border-border bg-card px-3 py-2 text-foreground" required><span class="text-sm text-muted">{{ "minutos" if isSpanish else "minutes" }}</span></span>
        </label>

        <label class="block rounded-xl border border-border bg-background p-5">
          <span class="mb-2 block font-semibold text-foreground">{{ "¿Cuánto tiempo estuviste despiertx durante la noche?" if isSpanish else "How long were you awake during the night?" }}</span>
          <span class="mb-3 block text-sm text-muted">{{ "Suma aproximadamente todos los despertares después de haberte dormido." if isSpanish else "Estimate all awakenings after initially falling asleep and add them together." }}</span>
          <span class="flex items-center gap-3"><input name="waso" type="number" inputmode="numeric" min="0" max="720" class="w-28 rounded-md border border-border bg-card px-3 py-2 text-foreground" required><span class="text-sm text-muted">{{ "minutos en total" if isSpanish else "total minutes" }}</span></span>
        </label>

        <label class="block rounded-xl border border-border bg-background p-5">
          <span class="mb-2 block font-semibold text-foreground">{{ "Hora del despertar final" if isSpanish else "Final awakening time" }}</span>
          <span class="mb-3 block text-sm text-muted">{{ "La última vez que despertaste, aunque hayas permanecido en la cama." if isSpanish else "The last time you woke, even if you stayed in bed afterward." }}</span>
          <input name="finalAwakening" type="time" class="w-full rounded-md border border-border bg-card px-3 py-2 text-foreground" required>
        </label>

        <label class="block rounded-xl border border-border bg-background p-5">
          <span class="mb-2 block font-semibold text-foreground">{{ "Hora en que saliste de la cama" if isSpanish else "Time you got out of bed" }}</span>
          <span class="mb-3 block text-sm text-muted">{{ "Cuando te levantaste para comenzar el día." if isSpanish else "When you got up to begin your day." }}</span>
          <input name="outOfBed" type="time" class="w-full rounded-md border border-border bg-card px-3 py-2 text-foreground" required>
        </label>

        <label class="block rounded-xl border border-border bg-background p-5 md:col-span-2">
          <span class="mb-2 block font-semibold text-foreground">{{ "Siestas" if isSpanish else "Naps" }}</span>
          <span class="mb-3 block text-sm text-muted">{{ "Si no dormiste siesta, escribe 0." if isSpanish else "Enter 0 if you did not nap." }}</span>
          <span class="flex items-center gap-3"><input name="naps" type="number" inputmode="numeric" min="0" max="720" value="0" class="w-28 rounded-md border border-border bg-card px-3 py-2 text-foreground" required><span class="text-sm text-muted">{{ "minutos en total" if isSpanish else "total minutes" }}</span></span>
        </label>

        <fieldset class="rounded-xl border border-border bg-background p-5 md:col-span-2">
          <legend class="px-1 font-semibold text-foreground">{{ "Factores que pudieron afectar tu sueño" if isSpanish else "Factors that may have affected your sleep" }}</legend>
          <p class="mb-4 text-sm text-muted">{{ "Elige todos los que apliquen. Esto no significa que uno de ellos haya causado una mala noche." if isSpanish else "Choose any that apply. Selecting one does not mean it caused a difficult night." }}</p>
          <div class="flex flex-wrap gap-2" data-factor-options>
            {% set factors = [
              { id: "stress", en: "Stress or worry", es: "Estrés o preocupación" },
              { id: "caffeine", en: "Caffeine", es: "Cafeína" },
              { id: "alcohol", en: "Alcohol", es: "Alcohol" },
              { id: "pain", en: "Pain or discomfort", es: "Dolor o incomodidad" },
              { id: "screens", en: "Screen time", es: "Pantallas" },
              { id: "medication", en: "Medication", es: "Medicamentos" },
              { id: "environment", en: "Noise, light, or temperature", es: "Ruido, luz o temperatura" },
              { id: "schedule", en: "Schedule change", es: "Cambio de horario" }
            ] %}
            {% for factor in factors %}
              <label class="cursor-pointer">
                <input class="peer sr-only" type="checkbox" name="factors" value="{{ factor.id }}">
                <span class="inline-flex rounded-full border border-border px-3 py-2 text-sm text-muted transition-colors peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-primary">{{ factor.es if isSpanish else factor.en }}</span>
              </label>
            {% endfor %}
          </div>
          <label class="mt-4 block"><span class="sr-only">{{ "Otro factor" if isSpanish else "Other factor" }}</span><input name="otherFactor" type="text" maxlength="120" placeholder="{{ 'Otro factor (opcional)' if isSpanish else 'Something else (optional)' }}" class="w-full rounded-md border border-border bg-card px-3 py-2 text-foreground"></label>
        </fieldset>
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-live="polite">
        <div class="rounded-xl bg-primary/10 p-4"><span class="block text-xs font-bold uppercase tracking-wider text-muted">{{ "Tiempo para dormirte" if isSpanish else "Time to fall asleep" }}</span><strong class="mt-1 block text-2xl text-primary" data-sol-total>—</strong></div>
        <div class="rounded-xl bg-accent/10 p-4"><span class="block text-xs font-bold uppercase tracking-wider text-muted">{{ "Tiempo despiertx en la noche" if isSpanish else "Time awake during the night" }}</span><strong class="mt-1 block text-2xl text-primary" data-waso-total>—</strong></div>
        <div class="rounded-xl bg-primary/10 p-4"><span class="block text-xs font-bold uppercase tracking-wider text-muted">{{ "Tiempo total de sueño" if isSpanish else "Total sleep time" }}</span><strong class="mt-1 block text-2xl text-primary" data-total-sleep>—</strong></div>
        <div class="rounded-xl bg-accent/10 p-4"><span class="block text-xs font-bold uppercase tracking-wider text-muted">{{ "Eficiencia del sueño" if isSpanish else "Sleep efficiency" }}</span><strong class="mt-1 block text-2xl text-primary" data-sleep-efficiency>—</strong></div>
      </div>

      <div class="mt-6 rounded-xl border border-border p-4 text-sm leading-relaxed text-muted" style="background: hsl(145 30% 45% / 0.08)">
        <p><span class="font-semibold text-foreground">{{ "Este diario existe únicamente en este navegador." if isSpanish else "This diary exists only in this browser." }}</span> {{ "Grey Wellness no recibe tus respuestas. Si borras los datos de este sitio en tu navegador, el diario desaparecerá y no podremos recuperarlo. Descarga tus respuestas antes de borrar los datos, cambiar de navegador o usar otro dispositivo." if isSpanish else "Grey Wellness does not receive your entries. If you clear this website's data from your browser, the diary will disappear and cannot be recovered. Download your completed entries before clearing data, changing browsers, or using another device." }}</p>
      </div>

      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button type="button" class="rounded-md border border-primary px-5 py-3 text-sm font-semibold uppercase tracking-wide text-primary hover:bg-primary/10" data-download-diary>{{ "Descargar Mis Respuestas (.CSV)" if isSpanish else "Download My Entries (.CSV)" }}</button>
        <button type="submit" class="rounded-md bg-primary px-5 py-3 text-sm font-semibold uppercase tracking-wide text-primary-foreground hover:opacity-90">{{ "Guardar esta mañana" if isSpanish else "Save This Morning" }}</button>
      </div>
      <p class="mt-3 hidden text-right text-sm font-semibold text-primary" role="status" data-save-message>{{ "Guardado en este dispositivo ✓" if isSpanish else "Saved on this device ✓" }}</p>
    </form>
  </section>

  <section class="mb-14" data-summary-section>
    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="text-xs font-bold uppercase tracking-widest text-primary">{{ "Tu Semana" if isSpanish else "Your Week" }}</p><h2 class="mt-2 text-2xl font-bold text-foreground">{{ "Resumen de siete mañanas" if isSpanish else "Seven-morning summary" }}</h2></div>
      <button type="button" class="text-left text-sm font-semibold text-primary hover:underline sm:text-right" data-clear-diary>{{ "Borrar todas mis respuestas" if isSpanish else "Clear all my entries" }}</button>
    </div>
    <div class="overflow-x-auto rounded-xl border border-border">
      <table class="w-full min-w-[1100px] border-collapse bg-card text-left text-sm">
        <thead class="bg-primary/10 text-foreground"><tr><th class="p-3">{{ "Fecha" if isSpanish else "Date" }}</th><th class="p-3">{{ "En cama" if isSpanish else "In bed" }}</th><th class="p-3">{{ "Intento de dormir" if isSpanish else "Attempted sleep" }}</th><th class="p-3">{{ "Para dormirte" if isSpanish else "Falling asleep" }}</th><th class="p-3">{{ "Despiertx en la noche" if isSpanish else "Awake at night" }}</th><th class="p-3">{{ "Despertar final" if isSpanish else "Final awakening" }}</th><th class="p-3">{{ "Fuera de cama" if isSpanish else "Out of bed" }}</th><th class="p-3">{{ "Siestas" if isSpanish else "Naps" }}</th><th class="p-3">{{ "Sueño total" if isSpanish else "Total sleep" }}</th><th class="p-3">{{ "Eficiencia" if isSpanish else "Efficiency" }}</th><th class="p-3">{{ "Factores" if isSpanish else "Factors" }}</th></tr></thead>
        <tbody data-summary-body></tbody>
      </table>
    </div>
  </section>

  <section class="mb-14 rounded-2xl border border-border bg-surface-warm p-7 md:p-9">
    <div class="grid gap-7 md:grid-cols-[1fr_auto] md:items-center">
      <div class="max-w-2xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">{{ "¿Prefieres Papel?" if isSpanish else "Prefer Pen and Paper?" }}</p>
        <h2 class="mb-3 text-2xl font-bold text-foreground">{{ "Imprime un diario de sueño en blanco." if isSpanish else "Print a blank sleep diary." }}</h2>
        <p class="leading-relaxed text-muted">{{ "Descarga la versión de siete días para completarla a mano cada mañana. No se guarda ninguna información en tu navegador." if isSpanish else "Download the seven-day worksheet and complete it by hand each morning. No information is stored in your browser." }}</p>
      </div>
      <a href="{{ '/assets/downloads/grey-wellness-diario-de-sueno-7-dias.pdf' if isSpanish else '/assets/downloads/grey-wellness-7-day-sleep-diary.pdf' }}" download class="inline-flex items-center justify-center rounded-md bg-primary px-5 py-3 text-center text-sm font-semibold uppercase tracking-wide text-primary-foreground hover:opacity-90">{{ "Descargar PDF para Imprimir" if isSpanish else "Download Printable PDF" }}</a>
    </div>
  </section>

  <aside class="mb-8 border-t border-border pt-8 text-sm leading-relaxed text-muted">
    <p><span class="font-semibold text-foreground">{{ "Una nota importante:" if isSpanish else "A gentle note:" }}</span> {{ "Este diario ofrece educación general y no interpreta, diagnostica ni trata un problema del sueño. Si te preocupa tu sueño o tu salud, habla con unx profesional calificadx." if isSpanish else "This diary provides general education and does not interpret, diagnose, or treat a sleep problem. If you are concerned about your sleep or health, speak with a qualified professional." }}</p>
  </aside>

  {% if isSpanish %}
  <script type="application/json" data-diary-copy>{"saved":"Guardado","ofSeven":"de 7 días completados","minutes":"min","hours":"h","none":"Ninguno seleccionado","empty":"Aún no hay una respuesta guardada.","noCompleted":"Los días aparecerán aquí a medida que los completes.","nothingToDownload":"Completa y guarda al menos un día antes de descargar el diario.","confirmClear":"¿Borrar las siete entradas guardadas en este dispositivo?","csvHeaders":["Fecha","Hora de acostarte","Intento de dormir","Tiempo para dormirte (min)","Tiempo despiertx en la noche (min)","Despertar final","Fuera de cama","Siestas (min)","Tiempo total de sueño (min)","Eficiencia del sueño (%)","Factores"],"factorLabels":{"stress":"Estrés o preocupación","caffeine":"Cafeína","alcohol":"Alcohol","pain":"Dolor o incomodidad","screens":"Pantallas","medication":"Medicamentos","environment":"Ruido, luz o temperatura","schedule":"Cambio de horario"}}</script>
  {% else %}
  <script type="application/json" data-diary-copy>{"saved":"Saved","ofSeven":"of 7 days completed","minutes":"min","hours":"hr","none":"None selected","empty":"No entry saved yet.","noCompleted":"Your days will appear here as you complete them.","nothingToDownload":"Complete and save at least one day before downloading your diary.","confirmClear":"Clear all seven entries saved on this device?","csvHeaders":["Date","Time in bed","Attempted sleep","Time to fall asleep (min)","Time awake during the night (min)","Final awakening","Out of bed","Naps (min)","Total sleep time (min)","Sleep efficiency (%)","Factors"],"factorLabels":{"stress":"Stress or worry","caffeine":"Caffeine","alcohol":"Alcohol","pain":"Pain or discomfort","screens":"Screen time","medication":"Medication","environment":"Noise, light, or temperature","schedule":"Schedule change"}}</script>
  {% endif %}
</div>

<style>
  @media print {
    nav, footer, [data-diary-form], [data-clear-diary], [data-diary-days], section:first-child, aside { display: none !important; }
    main { max-width: none !important; padding: 0 !important; }
    [data-summary-section] { display: block !important; margin: 0 !important; }
    [data-summary-section] table { min-width: 0 !important; font-size: 10px !important; }
    [data-summary-section] th, [data-summary-section] td { padding: 7px !important; border: 1px solid #bbb !important; }
  }
</style>
<script src="{{ '/assets/js/sleep-diary.js' | url }}" defer></script>
