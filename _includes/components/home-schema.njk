{% include 'components/website-schema.njk' %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MedicalOrganization",
  "@id": "{{ site.url }}/#practice",
  "name": "Grey Wellness",
  "description": {{ (description ~ " " ~ _t.service_availability) | dump | safe }},
  "url": "{{ site.url }}",
  "telephone": "+1-240-203-8879",
  "email": "contact@greywellness.com",
  "priceRange": "$$",
  "image": "{{ site.url }}/assets/img/og-image.jpg",
  "medicalSpecialty": ["SleepMedicine", "Psychiatric", "CommunityHealth"],
  "areaServed": {{ site.areasServed | dump | safe }},
  "sameAs": [
    "https://www.psychologytoday.com/profile/1256952",
    "https://www.instagram.com/grey_wellness/",
    "https://www.facebook.com/profile.php?id=61574329432986",
    "https://www.linkedin.com/company/grey-wellness"
  ],
  "founder": {
    "@type": "Person",
    "name": "Mónica Grey",
    "jobTitle": "{{ _t.home_schema_job_title }}",
    "honorificSuffix": "MS, LCPC, NCC",
    "knowsLanguage": ["en", "es"],
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "Johns Hopkins University"
    },
    "memberOf": [
      {
        "@type": "Organization",
        "name": "Society of Behavioral Sleep Medicine"
      },
      {
        "@type": "Organization",
        "name": "National Board for Certified Counselors"
      }
    ],
    "sameAs": [
      "https://www.psychologytoday.com/profile/1256952"
    ]
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "{{ _t.home_schema_offer_catalog }}",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "{{ _t.home_schema_cbti_name }}",
          "description": {{ (_t.home_schema_cbti_desc ~ " " ~ _t.service_availability) | dump | safe }},
          "areaServed": {{ site.areasServed | dump | safe }},
          "serviceType": "Cognitive Behavioral Therapy for Insomnia"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "{{ _t.home_schema_anxiety_name }}",
          "description": {{ (_t.home_schema_anxiety_desc ~ " " ~ _t.service_availability) | dump | safe }},
          "areaServed": {{ site.areasServed | dump | safe }},
          "serviceType": "Anxiety & Stress Management"
        }
      }
    ]
  },
  "availableLanguage": [
    { "@type": "Language", "name": "English" },
    { "@type": "Language", "name": "Spanish" }
  ]
}
</script>
