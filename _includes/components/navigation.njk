<nav class="glass" aria-label="{{ 'Navegación principal' if siteLang == 'es' else 'Main navigation' }}">
  <a class="signature" href="{{ localeHome | url }}" aria-label="{{ 'Grey Wellness, inicio' if siteLang == 'es' else 'Grey Wellness home' }}">
    <img src="{{ '/assets/img/grey-wellness-horizontal-purple.png' | url }}" width="1080" height="540" alt="">
  </a>
  {% if page_style == 'landing' %}
  <a class="navcta" href="tel:+12402038879">240-203-8879</a>
  {% else %}
  <div class="navlinks">
    <a href="{{ (localeHome ~ 'pages/treatment/') | url }}">{{ siteText.nav_specialties }}</a>
    <a href="{{ (localeHome ~ 'pages/about/') | url }}" {% if page.url == localeHome ~ 'pages/about/' %}aria-current="page"{% endif %}>{{ 'Nuestra práctica' if siteLang == 'es' else 'Our practice' }}</a>
  </div>
  {% for alternate in page.url | siteLocaleLinks %}
  <a class="nav-language" href="{{ alternate.url | url }}" lang="{{ alternate.lang }}" hreflang="{{ alternate.lang }}">{{ alternate.label }}</a>
  {% endfor %}
  <a class="navcta" href="{{ (localeHome ~ 'pages/contact/') | url }}">{{ 'Contacto' if siteLang == 'es' else 'Get in touch' }} <span aria-hidden="true">↗</span></a>
  <details class="site-menu">
    <summary>{{ 'Menú' if siteLang == 'es' else 'Menu' }}</summary>
    <div class="site-menu-panel">
      <div class="site-menu-column">
        <p>{{ siteText.nav_specialties }}</p>
        {% set specialtyLinks = [
          ['pages/treatment/', siteText.nav_services_what_we_treat],
          ['pages/sleep/', siteText.nav_specialties_sleep],
          ['pages/anxiety/', siteText.nav_specialties_anxiety],
          ['pages/trauma/', siteText.nav_specialties_trauma],
          ['pages/groups/', siteText.nav_services_groups],
          ['pages/process/', siteText.nav_services_how_we_work]
        ] %}
        {% for link in specialtyLinks %}
        <a href="{{ (localeHome ~ link[0]) | url }}" {% if page.url == localeHome ~ link[0] %}aria-current="page"{% endif %}>{{ link[1] }}</a>
        {% endfor %}
      </div>
      <div class="site-menu-column">
        <p>Grey Wellness</p>
        {% set practiceLinks = [
          ['pages/about/', siteText.nav_about],
          ['rates/', siteText.nav_investment],
          ['blog/', siteText.nav_blog],
          ['free-tools/', siteText.nav_tools],
          ['pages/faq/', siteText.nav_faq],
          ['pages/contact/', siteText.nav_contact]
        ] %}
        {% for link in practiceLinks %}
        <a href="{{ (localeHome ~ link[0]) | url }}" {% if page.url == localeHome ~ link[0] %}aria-current="page"{% endif %}>{{ link[1] }}</a>
        {% endfor %}
        <a href="https://monicagrey.clientsecure.me/sign-in">{{ siteText.nav_client_portal }} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </details>
  {% endif %}
</nav>
{% if page_style != 'landing' %}
<script src="{{ '/assets/js/navigation.js' | url }}" defer></script>
{% endif %}
