{% set es = lang == 'es' %}
{% set home = '/' ~ (lang or 'en') ~ '/' %}
{% set alternates = page.url | siteLocaleLinks %}
<footer id="footer" class="practice-footer">
  <div class="footer-intro">
    <a href="{{ home | url }}" aria-label="{{ 'Grey Wellness, inicio' if es else 'Grey Wellness home' }}"><img src="/assets/img/grey-wellness-horizontal-purple.png" width="1080" height="540" alt="Grey Wellness"></a>
    <p>{{ i18n[lang or 'en'].service_availability }}</p>
  </div>
  <div class="footer-directory">
    <section>
      <h2>{{ 'Contacto' if es else 'Contact' }}</h2>
      <a href="mailto:contact@greywellness.com">{{ 'Escríbenos' if es else 'Email the practice' }} ↗</a>
      <a href="tel:+12402038879">240-203-8879</a>
      <a href="https://monicagrey.clientsecure.me/sign-in">{{ 'Portal del cliente' if es else 'Client portal' }} ↗</a>
    </section>
    <section>
      <h2>{{ 'La práctica' if es else 'The practice' }}</h2>
      <a href="{{ home | url }}#about">{{ 'Conoce a Mónica' if es else 'Meet Mónica' }}</a>
      <a href="{{ home | url }}#specialties">{{ 'Especialidades' if es else 'Therapy specialties' }}</a>
      <a href="{{ home | url }}#contact">{{ 'Consulta gratuita' if es else 'Free consultation' }}</a>
    </section>
    <section>
      <h2>{{ 'Recursos' if es else 'Resources' }}</h2>
      <a href="{{ ('/assets/resources/sleep-diary-' ~ (lang or 'en') ~ '.pdf') | url }}">{{ 'Diario de sueño de 14 días' if es else '14-day sleep diary' }} <small>PDF</small></a>
      <a href="https://www.psychologytoday.com/profile/1256952">Psychology Today ↗</a>
      <a href="https://www.therapyden.com/therapist/monica-grey">TherapyDen ↗</a>
    </section>
  </div>
  <div class="footer-base">
    <span>© Grey Wellness LLC</span>
    <div><a href="https://www.instagram.com/grey_wellness/">Instagram</a><a href="https://www.facebook.com/profile.php?id=61574329432986">Facebook</a><a href="https://www.linkedin.com/company/grey-wellness">LinkedIn</a></div>
    {% for alt in alternates %}<a href="{{ alt.url | url }}" lang="{{ alt.lang }}" hreflang="{{ alt.lang }}">{{ alt.label }}</a>{% endfor %}
  </div>
</footer>
