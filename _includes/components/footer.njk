{% from "macros/logo.njk" import logo %}
{% block footer %}
  {# Resolve locale-specific data for this render #}
  {% set _lang = lang | default("en") %}
  {% set _t = i18n[_lang] %}

  <footer class="border-t border-border bg-surface">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 py-10">
      <div class="grid gap-8 md:grid-cols-3">
        <div class="space-y-3">
          <div class="flex items-center h-7">
            {{ logo() }}
          </div>
          <p class="text-sm text-muted">
            {{ _t.footer_tagline }}
          </p>
          <a href="{{ '/' + _lang + '/pages/contact/' | url }}" class="inline-block px-4 py-2 text-sm font-medium tracking-wide uppercase bg-primary text-primary-foreground rounded-md hover:opacity-90 transition-opacity">{{ _t.footer_send_message }}</a>
        </div>
        <div class="space-y-3">
          <p class="text-sm font-semibold text-foreground">{{ _t.footer_contact_label }}</p>
          <ul class="space-y-2 text-sm text-muted">
            <li><a href="tel:+12402038879" class="hover:text-primary transition-colors">Office: 240-203-8879</a></li>
            <li class="hover:text-primary transition-colors">Fax: 240-627-2513</li>
            <li><a href="mailto:contact@greywellness.com?subject=Inquiry" class="hover:text-primary transition-colors">contact@greywellness.com</a></li>
          </ul>
        </div>
        <div class="space-y-3">
          <p class="text-sm font-semibold text-foreground">{{ _t.footer_company }}</p>
          <ul class="space-y-2 text-sm text-muted">
            <li>
              <a href="{{ '/' + _lang + '/pages/about/' | url }}" class="hover:text-primary transition-colors">{{ _t.footer_about }}</a>
            </li>
            <li>
              <a href="{{ '/' + _lang + '/pages/treatment/' | url }}" class="hover:text-primary transition-colors">{{ _t.footer_services }}</a>
            </li>
            <li>
              <a href="{{ '/' + _lang + '/free-tools/' | url }}" class="hover:text-primary transition-colors">{{ _t.footer_tools }}</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-col gap-6 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-4">
          <a href="https://www.facebook.com/profile.php?id=61574329432986" target="_blank" rel="noopener noreferrer" aria-label="{{ _t.footer_social_facebook }}" class="text-muted hover:text-primary transition-colors">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M22 12.06C22 6.48 17.52 2 11.94 2S1.88 6.48 1.88 12.06c0 5.02 3.66 9.19 8.44 9.94v-7.03H7.9v-2.91h2.42V9.91c0-2.39 1.42-3.71 3.6-3.71 1.04 0 2.13.19 2.13.19v2.34h-1.2c-1.18 0-1.55.74-1.55 1.5v1.8h2.64l-.42 2.91h-2.22V22c4.78-.75 8.44-4.92 8.44-9.94Z"/></svg>
          </a>
          <a href="https://www.instagram.com/grey_wellness/" target="_blank" rel="noopener noreferrer" aria-label="{{ _t.footer_social_instagram }}" class="text-muted hover:text-primary transition-colors">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-5 h-5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/grey-wellness" target="_blank" rel="noopener noreferrer" aria-label="{{ _t.footer_social_linkedin }}" class="text-muted hover:text-primary transition-colors">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.59 0 4.25 2.36 4.25 5.44v6.3ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
          </a>
        </div>
        <div class="flex items-center gap-4 flex-wrap">
          {# Psychology Today verified profile seal #}
          <a href="https://www.psychologytoday.com/profile/1256952" class="sx-verified-seal" aria-label="{{ _t.footer_badge_pt }}"></a>
          {# Mentaya verified provider badge #}
          <a href="https://mentaya.com" target="_blank" rel="noopener noreferrer" aria-label="{{ _t.footer_badge_mentaya }}">
            <img src="https://storage.googleapis.com/zaya-health.appspot.com/public-images/mentaya_partner_badge_light.png" alt="Mentaya" class="h-12 w-auto">
          </a>
          {# LatinX Therapy directory badge #}
          <a href="https://www.latinxtherapy.com" target="_blank" rel="noopener noreferrer" aria-label="{{ _t.footer_badge_latinx }}">
            <img src="{{ '/assets/img/badges/latinx-therapy.png' | url }}" alt="LatinX Therapy Directory" class="h-12 w-auto">
          </a>
          {# NBCC Board Certified (NCC) badge #}
          <a href="https://www.nbcc.org" target="_blank" rel="noopener noreferrer" aria-label="{{ _t.footer_badge_nbcc }}">
            <img src="{{ '/assets/img/badges/nbcc-ncc.png' | url }}" alt="NBCC Board Certified, NCC" class="h-12 w-auto">
          </a>
        </div>
      </div>
      <div class="mt-6 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>© <span data-footer-year></span> Grey Wellness LLC. {{ _t.footer_rights }}</p>
        <p>{{ _t.footer_built_with }}</p>
      </div>
    </div>
  </footer>
  <script src="https://member.psychologytoday.com/verified-seal.js" data-badge="13" data-id="1256952" data-code="aHR0cHM6Ly93d3cucHN5Y2hvbG9neXRvZGF5LmNvbS9hcGkvdmVyaWZpZWQtc2VhbC9zZWFscy8xMy9wcm9maWxlLzEyNTY5NTI/Y2FsbGJhY2s9c3hjYWxsYmFjaw==" async defer></script>
  <script>
    (() => {
      const year = document.querySelector("[data-footer-year]");
      if (year) year.textContent = new Date().getFullYear();
    })();
  </script>
{% endblock %}
