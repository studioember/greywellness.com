{% set _lang = lang | default("en") %}
{% set _t = i18n[_lang] %}

<dialog
  data-virginia-announcement
  aria-labelledby="virginia-announcement-title"
  aria-describedby="virginia-announcement-description"
  class="m-auto w-[calc(100%-2rem)] max-w-lg overflow-hidden rounded-2xl border border-border bg-card p-0 text-foreground shadow-2xl backdrop:bg-foreground/60 backdrop:backdrop-blur-sm"
>
  <div class="relative px-6 py-8 sm:px-9 sm:py-10">
    <form method="dialog">
      <button
        type="submit"
        data-virginia-announcement-close
        class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full text-muted transition-colors hover:bg-primary/10 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary"
        aria-label="{{ _t.virginia_popup_close }}"
      >
        <span aria-hidden="true" class="text-2xl leading-none">×</span>
      </button>
    </form>

    <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">{{ _t.virginia_popup_eyebrow }}</p>
    <h2 id="virginia-announcement-title" class="pr-8 text-2xl font-bold leading-tight sm:text-3xl">{{ _t.virginia_popup_title }}</h2>
    <p id="virginia-announcement-description" class="mt-4 leading-relaxed text-muted">{{ _t.virginia_popup_body }}</p>

    <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a
        href="{{ '/' + _lang + '/pages/contact/' | url }}"
        data-virginia-announcement-cta
        class="inline-block rounded-md bg-primary px-6 py-3 text-center text-sm font-bold uppercase tracking-wide text-primary-foreground transition-opacity hover:opacity-90"
      >{{ _t.virginia_popup_cta }}</a>
      <form method="dialog">
        <button type="submit" data-virginia-announcement-close class="w-full px-4 py-3 text-sm font-semibold text-muted transition-colors hover:text-primary sm:w-auto">
          {{ _t.virginia_popup_not_now }}
        </button>
      </form>
    </div>
  </div>
</dialog>

<script>
  (() => {
    const dialog = document.querySelector("[data-virginia-announcement]");
    if (!dialog || typeof dialog.showModal !== "function") return;

    const storageKey = "grey-wellness-virginia-announcement-v1";
    const hasSeenAnnouncement = () => {
      try { return sessionStorage.getItem(storageKey) === "seen"; }
      catch (_) { return false; }
    };
    const rememberAnnouncement = () => {
      try { sessionStorage.setItem(storageKey, "seen"); }
      catch (_) {}
    };

    if (!hasSeenAnnouncement()) {
      window.setTimeout(() => dialog.showModal(), 700);
    }

    dialog.addEventListener("close", rememberAnnouncement);
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector("[data-virginia-announcement-cta]")?.addEventListener("click", () => {
      rememberAnnouncement();
      if (typeof gtag === "function") {
        gtag("event", "virginia_announcement_cta_clicked", {
          event_category: "engagement",
          event_label: "Virginia announcement"
        });
      }
    });
  })();
</script>
