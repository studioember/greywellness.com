---
permalink: /index.html
eleventyExcludeFromCollections: true
sitemap: false
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ site.name }}</title>
    <meta property="og:site_name" content="{{ site.name }}">
    {% include 'components/website-schema.njk' %}
    <noscript><meta http-equiv="refresh" content="0; url=/en/"></noscript>
    <link rel="canonical" href="{{ site.url }}/en/">
    <script>
      const preferences = navigator.languages?.length ? navigator.languages : [navigator.language];
      const preferred = preferences.find(language => /^(en|es)(-|$)/i.test(language));
      const home = /^es/i.test(preferred || '') ? '/es/' : '/en/';
      window.location.replace(home + window.location.search + window.location.hash);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href="/en/">/en/</a>…</p>
  </body>
</html>
